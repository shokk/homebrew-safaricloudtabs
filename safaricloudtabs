#!/bin/zsh

set -euo pipefail

DB_PATH="${HOME}/Library/Containers/com.apple.Safari/Data/Library/Safari/SafariTabs.db"
SQL_QUERY="SELECT (SELECT title FROM bookmarks WHERE id = b.parent) AS TabGroup, title, url FROM bookmarks b WHERE parent IN (SELECT id FROM bookmarks WHERE type = 1) AND title != 'TopScopedBookmarkList' AND (SELECT title FROM bookmarks WHERE id = b.parent) != 'Root' ORDER BY TabGroup, title;"

usage() {
  cat <<'EOF'
Usage: safaricloudtabs [option]

Show Safari iCloud tab group data from SafariTabs.db.

Options:
  -h          Show this help text and exit
  -d          List duplicate tab URLs
  -n          List the number of tabs in each tab group
  -g REGEX    Grep the tab listing with the provided regex
  -l          List all tabs as pipe-delimited output
  -t          List all tabs as a Markdown table
  -c          List all tabs as CSV
  -L          List tab group names sorted alphabetically
  -s [GROUP]  List tabs in a specific tab group; omit GROUP to pick interactively

Examples:
  safaricloudtabs -d
  safaricloudtabs -n
  safaricloudtabs -g 'openai|github'
  safaricloudtabs -l
  safaricloudtabs -t
  safaricloudtabs -c
  safaricloudtabs -L
  safaricloudtabs -s "Work"
  safaricloudtabs -s
EOF
}

require_db() {
  if [[ ! -f "$DB_PATH" ]]; then
    print -u2 "Safari tabs database not found: $DB_PATH"
    exit 1
  fi
}

run_query() {
  sqlite3 -json "$DB_PATH" "$SQL_QUERY"
}

print_pipe_output() {
  run_query | jq -r '
    .[] | [(.TabGroup // ""), (.title // ""), (.url // "")] | join("|")
  '
}

print_csv_output() {
  run_query | jq -r '
    .[] | [(.TabGroup // ""), (.title // ""), (.url // "")] | @csv
  '
}

list_groups() {
  run_query | jq -r '.[] | .TabGroup // empty' | sort -u
}

print_group_tabs() {
  local group="$1"
  run_query | jq -r --arg g "$group" '
    .[] | select(.TabGroup == $g) | [(.title // ""), (.url // "")] | join("|")
  '
}

select_group_interactively() {
  local -a groups
  groups=("${(@f)$(list_groups)}")
  if [[ ${#groups[@]} -eq 0 ]]; then
    print -u2 "No tab groups found."
    exit 1
  fi
  local i
  for i in {1..${#groups[@]}}; do
    printf '%d) %s\n' "$i" "${groups[$i]}"
  done
  printf 'Select a tab group: '
  local choice
  read -r choice
  if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#groups[@]} )); then
    print -u2 "Invalid selection."
    exit 1
  fi
  print_group_tabs "${groups[$choice]}"
}

print_markdown_table() {
  printf '| TabGroup | Title | URL |\n'
  printf '| --- | --- | --- |\n'
  run_query | jq -r '
    def mdcell:
      (. // "")
      | tostring
      | gsub("\r"; "")
      | gsub("\n"; " ")
      | gsub("\\|"; "&#124;");
    .[] | "| \( .TabGroup | mdcell ) | \( .title | mdcell ) | \( .url | mdcell ) |"
  '
}

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

require_db

opt_h=0 opt_d=0 opt_n=0 opt_l=0 opt_t=0 opt_c=0 opt_L=0
opt_g=0
grep_pattern=""
opt_s=0
s_arg=""
s_given=0

while getopts ":hdng:ltcLs:" opt; do
  case "$opt" in
    h) opt_h=1 ;;
    d) opt_d=1 ;;
    n) opt_n=1 ;;
    g) opt_g=1; grep_pattern="$OPTARG" ;;
    l) opt_l=1 ;;
    t) opt_t=1 ;;
    c) opt_c=1 ;;
    L) opt_L=1 ;;
    s) opt_s=1; s_arg="$OPTARG"; s_given=1 ;;
    :)
      if [[ "$OPTARG" == "s" ]]; then
        opt_s=1
        s_given=0
      else
        print -u2 "Option -$OPTARG requires an argument."
        print -u2 ""
        usage >&2
        exit 1
      fi
      ;;
    \?)
      print -u2 "Unknown option: -$OPTARG"
      print -u2 ""
      usage >&2
      exit 1
      ;;
  esac
done

if [[ $opt_h -eq 1 ]]; then
  usage
  exit 0
fi

if [[ $opt_g -eq 1 && $opt_n -eq 1 ]]; then
  print_pipe_output | grep -E -- "$grep_pattern" | awk -F '|' '{print $1}' | sort | uniq -c | awk '{printf "%3d %s\n", $1, $2}'
  exit 0
fi

if [[ $opt_d -eq 1 ]]; then
  run_query | jq -r '.[] | .url // empty' | sort | uniq -d
  exit 0
fi

if [[ $opt_n -eq 1 ]]; then
  run_query | jq -r '.[] | .TabGroup // empty' | uniq -c | sort -n
  exit 0
fi

if [[ $opt_g -eq 1 ]]; then
  print_pipe_output | grep -E -- "$grep_pattern"
  exit 0
fi

if [[ $opt_l -eq 1 ]]; then
  print_pipe_output
  exit 0
fi

if [[ $opt_t -eq 1 ]]; then
  print_markdown_table
  exit 0
fi

if [[ $opt_c -eq 1 ]]; then
  print_csv_output
  exit 0
fi

if [[ $opt_L -eq 1 ]]; then
  list_groups
  exit 0
fi

if [[ $opt_s -eq 1 ]]; then
  if [[ $s_given -eq 1 ]]; then
    print_group_tabs "$s_arg"
  else
    select_group_interactively
  fi
  exit 0
fi

usage
